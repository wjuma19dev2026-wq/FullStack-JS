{
  "name": "apv-backend",
  "version": "1.0.0",
  "description": "Aprendiendo JS FullStack",
  "license": "ISC",
  "author": "Wilson Juma",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node --env-file=../.env index.js",
    "watch:server": "nodemon --env-file=../.env  --ignore 'public/**/*' index.js",
    "watch:browser": "NODE_OPTIONS=\"--disable-warning=DEP0060\" browser-sync start --proxy 'localhost:4000' --files 'public/**/*,views/**/*.ejs,index.js' --reloadDelay 1000",
    "dev:bs": "npm-run-all --parallel watch:server watch:browser",
    "dev:debug": "nodemon --env-file=../.env --inspect=9229 index.js",
    "dev": "nodemon index"
  },
  "dependencies": {
    "@vladimir-plakhotnik/scryptjs": "^1.2.0",
    "argon2": "^0.45.2",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.1"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "browser-sync": "^3.0.4",
    "colors": "^1.4.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "morgan": "^1.12.1",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5"
  }
}
